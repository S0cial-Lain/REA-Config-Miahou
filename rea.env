# ==============================================================================
#  REA config — extracted for the Miahou fork
#  Source of truth: rea-agents@6.9.0  (~/.local/lib/node_modules/rea-agents)
#  Extracted: 2026-11-17  by Miahou
#
#  Drop-in .env for a Miahou-integrated REA. Values marked [DEFAULT] are REA's
#  own compiled defaults, re-stated here EXPLICITLY so the fork is deterministic
#  and doesn't drift when upstream changes a default. Lines with a real override
#  are marked [OVERRIDE].
#
#  NOTHING SECRET BELONGS IN THIS FILE. REA takes no credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE / SESSION
# ------------------------------------------------------------------------------
# Analysis provider selector. Empty = deterministic auto-routing by target format.
# Accepted: ghidra | rizin | kuna | hopper | ida | jeb | objdump | native-macos
# On this box: ghidra 12.1.2 @ /opt/ghidra  (rizin, objdump also available)
REA_ANALYSIS_PROVIDER=ghidra

# Workflow provider id used to wrap upstream provider results into Evidence.
REA_WORKFLOW_PROVIDER=rea-workflow

# Log verbosity: debug | info | warn | error | silent
REA_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. GHIDRA BRIDGE  (primary provider on this host)
# ------------------------------------------------------------------------------
# Private, absolute dir for cross-process metadata checkpoints (renames,
# comments, bookmarks). WITHOUT this, Ghidra runs ephemeral and ALL annotation
# edits are discarded on close. This is the single most important override.
REA_GHIDRA_CHECKPOINT_DIR=/home/lain/.miahou/rea/ghidra-checkpoints

# Optional: reuse an existing Ghidra project instead of an ephemeral copy.
# REA_GHIDRA_PROJECT_PATH=
# REA_GHIDRA_PROGRAM_NAME=

# Language / compiler overrides for raw or misdetected images.
# REA_GHIDRA_LANGUAGE_ID=
# REA_GHIDRA_COMPILER_SPEC_ID=

# NativeAOT symbol-recovery jar (only for .NET NativeAOT targets).
# REA_GHIDRA_NATIVEAOT_JAR=

# Seed file for headless import.
# REA_GHIDRA_SEED_FILE=

# Comma-separated Ghidra analyzer class names to skip (faster opens on huge bins).
# REA_GHIDRA_DISABLED_ANALYZERS=

REA_GHIDRA_STARTUP_TIMEOUT_MS=330000
REA_GHIDRA_DECOMPILE_TIMEOUT_SECONDS=120
REA_GHIDRA_DECOMPILE_MAX_PAYLOAD_MIB=2047
REA_GHIDRA_VALUE_FLOW_MAX_OPERATIONS=3000
REA_GHIDRA_VALUE_FLOW_MAX_INPUTS_PER_OPERATION=64
REA_GHIDRA_VALUE_FLOW_MAX_EDGES=12000

# ------------------------------------------------------------------------------
# 3. ALTERNATE PROVIDERS / EXTERNAL TOOLS
# ------------------------------------------------------------------------------
REA_RIZIN_COMMAND=/usr/bin/rizin
REA_OBJDUMP_COMMAND=/usr/bin/objdump
REA_GDB_COMMAND=/usr/bin/gdb
# REA_KUNA_COMMAND=
# REA_KUNA_CACHE_DIR=
# REA_IDA_MCP_CONFIG=
# REA_JEB_MCP_URL=http://127.0.0.1:8425/mcp
REA_JEB_MCP_TIMEOUT_MS=60000
# REA_HOPPER_STARTUP_TIMEOUT_MS=120000        # macOS only on this host
# REA_HOPPER_CALLER_SCAN_BUDGET_MS=2000
# REA_MANAGED_LINUX_HOPPER_LAUNCHER=
# REA_ILSPY_CMD_PATH=                         # .NET managed decompile

# ------------------------------------------------------------------------------
# 4. MCP TRANSPORT  (this is how Miahou talks to REA)
# ------------------------------------------------------------------------------
# Advertised tool families — comma-separated subset. Trimming this is the single
# biggest context win: unneeded schemas never enter the session.
# Valid ids: direct,enhanced,native,artifact,managed,firmware,android,pcap,
#            flutter,frida,apktool,jeb,adb,browser,electron,javascript-runtime,
#            application,session
REA_MCP_TOOL_FAMILIES=direct,enhanced,native,artifact,managed,firmware,session

REA_MCP_INPUT_SCHEMA_PROFILE=compact     # compact | full
REA_MCP_OUTPUT_SCHEMA_PROFILE=compact    # compact | full
REA_MCP_TOOL_CATALOG_PROFILE=full        # full
REA_MCP_MAX_RESPONSE_BYTES=16777216
REA_MCP_MAX_INPUT_ELEMENTS=100000
REA_MCP_INITIALIZE_BUDGET_MS=30000
REA_MCP_FIRST_CATALOG_BUDGET_MS=60000
REA_MCP_TOOLS_LIST_BUDGET_MS=30000
REA_MCP_DOCTOR_DEADLINE_MS=120000

# ------------------------------------------------------------------------------
# 5. RESOURCE LIMITS  (REA defaults, pinned)
# ------------------------------------------------------------------------------
REA_BRIDGE_MAX_REQUEST_BYTES=16777216
REA_ASAR_MAX_HEADER_BYTES=16777216
REA_ASAR_MAX_LISTING_BYTES=67108864
REA_NATIVE_MATCHING_REPRESENTATION_BYTES=100663296
REA_REGEX_MATCHING_DEADLINE_MS=5000
REA_REGEX_WORKER_HEAP_REQUEST_MIB=128
REA_CAPTURE_DECODER_OLD_GENERATION_MIB=192
REA_DEBUGGER_COMMAND_DEADLINE_MS=120000
REA_DEBUGGER_MAX_COMMAND_OUTPUT_BYTES=16777216
REA_DEBUGGER_MAX_SESSIONS=8
REA_DEBUGGER_MAX_PENDING_COMMANDS=16
REA_JADX_OPERATION_TIMEOUT_MS=120000
REA_PWNTOOLS_MAX_INPUT_BYTES=33554432
REA_WINDOWS_CHANGE_TIME_DRIFT_MS=2000
REA_WINDOWS_CHANGE_TIME_SETTLE_POLL_MS=25
REA_WINDOWS_CHANGE_TIME_SETTLE_MAX_POLLS=40

# ------------------------------------------------------------------------------
# 6. OPTIONAL MODULES  (uncomment + point at the binary when you install them)
# ------------------------------------------------------------------------------
# REA_ADB_PATH=/usr/bin/adb
# REA_APKTOOL_COMMAND=/usr/bin/apktool
# REA_JADX_MCP_JAR=/home/lain/tools/jadx-mcp.jar
# REA_JADX_HEAP_MIB=4096
# REA_JADX_ACTIVE_PROCESSOR_COUNT=4
# REA_TSHARK_COMMAND=/usr/bin/tshark
# REA_CAPINFOS_COMMAND=/usr/bin/capinfos
# REA_TSHARK_PRLIMIT_COMMAND=/usr/bin/prlimit
# REA_WABT_BIN_DIRECTORY=/opt/wabt/bin
# REA_WAKARU_COMMAND=/usr/local/bin/wakaru
# REA_UNBLOB_COMMAND=/usr/local/bin/unblob
# REA_BINWALK_COMMAND=/usr/bin/binwalk
# REA_SIGROK_COMMAND=/usr/bin/sigrok-cli
# REA_MITMDUMP_COMMAND=/usr/bin/mitmdump
# REA_BROWSER_EXECUTABLE=/usr/bin/chromium
# REA_BROWSER_NO_SANDBOX=1
# REA_CUTTER_BRIDGE_DIR=/home/lain/.miahou/rea/cutter-bridge
# REA_EVM_PRLIMIT_COMMAND=/usr/bin/prlimit
# REA_FIRMWARE_PRLIMIT_COMMAND=/usr/bin/prlimit
# REA_JAVASCRIPT_PRLIMIT_COMMAND=/usr/bin/prlimit
# REA_PWNTOOLS_PYTHON=/home/lain/.miahou/venv/bin/python
# REA_PWNDBG_GDB=
# REA_PWNDBG_GDBINIT=
# REA_PWNDBG_VENV_PATH=
# REA_DOCKER_COMMAND=/usr/bin/docker
# REA_AGENT_ENV_COMMAND=/usr/local/bin/agentenv
# REA_BUILD_COMPUTER_REA_ARCHIVE=/home/lain/Miahou/rea-fork/rea-agents.tgz

# ------------------------------------------------------------------------------
# 7. SECRET REDACTION  (keeps YOUR secrets out of Evidence — set this)
# ------------------------------------------------------------------------------
# JSON array of regexes; matching values are replaced in retained Evidence.
# Example: ["(?i)api[_-]?key\\s*[:=]\\s*\\S+","sk-[A-Za-z0-9]{20,}"]
# REA_REFERENCE_SECRET_PATTERNS_JSON=[]

# ------------------------------------------------------------------------------
# 8. INTERNAL — set by REA itself, do NOT set manually
# ------------------------------------------------------------------------------
# REA_PROCESS_RUN_ID   REA_RUN_ID   REA_OWNS_PROCESS_LIFETIME
# REA_PAYLOAD          REA_SOCKET   REA_TOKEN   REA_TARGET_PATH   REA_TIMEOUT_S
# REA_STATE_FORMAT     REA_BUILD_COMMIT     REA_INSTALL_SCRIPT
# REA_X11_DIAGNOSTIC   REA_DCONF_COMMAND    REA_XPROP_COMMAND
# REA_DARWIN_MODULE_CACHE_PATH   REA_DARWIN_SWIFTC_PATH
# REA_SWIFTC_COMPILE_TIMEOUT_MS  REA_WINDOWS_NATIVE
# REA_RECONNECT_TIMEOUT_SECONDS  REA_ELECTRON_CAPTURE_ARGV
