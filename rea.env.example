# REA — minimal working config for the Miahou fork
# 6 lines. Everything else has a sane default. See rea.env for the full surface.
# Usage:  set -a; . rea.env.example; set +a

REA_ANALYSIS_PROVIDER=ghidra
REA_GHIDRA_CHECKPOINT_DIR=/home/lain/.miahou/rea/ghidra-checkpoints
REA_LOG_LEVEL=info
REA_MCP_TOOL_FAMILIES=direct,enhanced,native,artifact,managed,firmware,session
REA_MCP_INPUT_SCHEMA_PROFILE=compact
REA_MCP_OUTPUT_SCHEMA_PROFILE=compact
